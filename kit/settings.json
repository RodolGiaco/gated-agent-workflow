{
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(claude *)",
      "Bash(gh auth *)",
      "Bash(gh repo delete *)",
      "Bash(gh api *)",
      "Read(.env)",
      "Edit(.env)"
    ],
    "ask": [
      "Edit(/kit/**)",
      "Edit(/.github/**)",
      "Edit(/CLAUDE.md)"
    ],
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git restore *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh repo view *)",
      "Edit(/java/**)",
      "Write(/java/**)",
      "Bash(mvn *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(echo *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(sed *)",
      "Bash(python3 *)",
      "Bash(diff *)",
      "Bash(test *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-push.sh",
            "args": [],
            "if": "Bash(git *)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-commit.sh",
            "args": [],
            "if": "Bash(git *)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-merge.sh",
            "args": [],
            "if": "Bash(gh *)",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.sh",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
